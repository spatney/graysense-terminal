{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Graysense",
  "mainBinaryName": "graysense",
  "version": "0.1.0",
  "identifier": "com.graysense.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Graysense",
        "width": 1600,
        "height": 980,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Sachin Patney",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Sachin Patney",
    "shortDescription": "A futuristic workbench for GitHub Copilot agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
